# SENTINEL AI - Environment Configuration
# Copy this file to .env and fill in your API keys

# Apify API Token (for social media data collection)
# Get yours at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Exa API Key (for financial news ingestion)
# Get yours at: https://exa.ai
EXA_API_KEY=

# Market Data API Key (optional - yfinance is used by default and doesn't require a key)
MARKET_DATA_API_KEY=

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./sentinel.db

# Automation & Webhook Security (Required to authenticate n8n/cron triggers)
AUTOMATION_API_KEY=

# Dashboard Administrative Access Key (Kept server-side only; entered by user in Operations Console)
DASHBOARD_ADMIN_KEY=

# CORS Configuration (Comma-separated allowlist of frontend domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501

# FastAPI Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Streamlit Settings
FRONTEND_PORT=8501
