{
  "name": "Workflow A - Scheduled Market Data Collection (SENTINEL.AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "e44d32a1-0001-4000-8000-000000000001",
      "name": "Schedule Trigger (Every 4 Hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://sentinel-backend:8000/api/collect/market",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sentinel-Automation-Key",
              "value": "={{ $env.SENTINEL_AUTOMATION_KEY || 'sentinel-automation-secret-key' }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "e44d32a1-0001-4000-8000-000000000002",
      "name": "Trigger Market Collection (HKEX & KRX)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "success"
            }
          ]
        }
      },
      "id": "e44d32a1-0001-4000-8000-000000000003",
      "name": "Verify Ingestion Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "log_message",
              "value": "Market Data Collection verified for HKEX & KRX. Records processed: {{ $json.records_collected || 0 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a1-0001-4000-8000-000000000004",
      "name": "Log Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error_alert",
              "value": "Market Data Collection Failed: {{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a1-0001-4000-8000-000000000005",
      "name": "Log Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 4 Hours)": {
      "main": [
        [
          {
            "node": "Trigger Market Collection (HKEX & KRX)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Market Collection (HKEX & KRX)": {
      "main": [
        [
          {
            "node": "Verify Ingestion Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Ingestion Success": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
