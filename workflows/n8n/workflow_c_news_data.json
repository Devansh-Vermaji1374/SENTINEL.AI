{
  "name": "Workflow C - Financial News Wire Collection (SENTINEL.AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "e44d32a3-0003-4000-8000-000000000001",
      "name": "Schedule Trigger (Every 6 Hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://sentinel-backend:8000/api/collect/news",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sentinel-Automation-Key",
              "value": "={{ $env.SENTINEL_AUTOMATION_KEY || 'sentinel-automation-secret-key' }}"
            }
          ]
        },
        "options": {
          "timeout": 45000
        }
      },
      "id": "e44d32a3-0003-4000-8000-000000000002",
      "name": "Trigger Exa News Ingestion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "success"
            }
          ]
        }
      },
      "id": "e44d32a3-0003-4000-8000-000000000003",
      "name": "Verify News Articles & Dates",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "log_message",
              "value": "News articles ingested and sanitized. Articles processed: {{ $json.records_collected || 0 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a3-0003-4000-8000-000000000004",
      "name": "Log News Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error_alert",
              "value": "News wire collection failed: {{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a3-0003-4000-8000-000000000005",
      "name": "Log News Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 6 Hours)": {
      "main": [
        [
          {
            "node": "Trigger Exa News Ingestion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Exa News Ingestion": {
      "main": [
        [
          {
            "node": "Verify News Articles & Dates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify News Articles & Dates": {
      "main": [
        [
          {
            "node": "Log News Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log News Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
