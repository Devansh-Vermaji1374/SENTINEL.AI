{
  "name": "Workflow B - Multi-Source Social Intelligence Collection (SENTINEL.AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "e44d32a2-0002-4000-8000-000000000001",
      "name": "Schedule Trigger (Every 6 Hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://sentinel-backend:8000/api/collect/social",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sentinel-Automation-Key",
              "value": "={{ $env.SENTINEL_AUTOMATION_KEY || 'sentinel-automation-secret-key' }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "id": "e44d32a2-0002-4000-8000-000000000002",
      "name": "Trigger Apify Multi-Source Social Scraper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "success"
            }
          ]
        }
      },
      "id": "e44d32a2-0002-4000-8000-000000000003",
      "name": "Validate 10-Day Window & Records",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "log_message",
              "value": "Social intelligence collection successful. Posts collected: {{ $json.records_collected || 0 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a2-0002-4000-8000-000000000004",
      "name": "Log Social Batch Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error_alert",
              "value": "Social data collection failed or returned empty: {{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a2-0002-4000-8000-000000000005",
      "name": "Log Social Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 6 Hours)": {
      "main": [
        [
          {
            "node": "Trigger Apify Multi-Source Social Scraper",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Apify Multi-Source Social Scraper": {
      "main": [
        [
          {
            "node": "Validate 10-Day Window & Records",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate 10-Day Window & Records": {
      "main": [
        [
          {
            "node": "Log Social Batch Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Social Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
