{
  "name": "Workflow D - FinBERT Sentiment Pipeline & Alignment (SENTINEL.AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "e44d32a4-0004-4000-8000-000000000001",
      "name": "Schedule Trigger (Post-Collection)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://sentinel-backend:8000/api/collect/all",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sentinel-Automation-Key",
              "value": "={{ $env.SENTINEL_AUTOMATION_KEY || 'sentinel-automation-secret-key' }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "e44d32a4-0004-4000-8000-000000000002",
      "name": "Run FinBERT Inference & Feature Alignment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "success"
            }
          ]
        }
      },
      "id": "e44d32a4-0004-4000-8000-000000000003",
      "name": "Check Sentiment Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "log_message",
              "value": "FinBERT sentiment pipeline completed with point-in-time alignment. Details: {{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a4-0004-4000-8000-000000000004",
      "name": "Log Sentiment Alignment Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error_alert",
              "value": "FinBERT processing failed: {{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a4-0004-4000-8000-000000000005",
      "name": "Log FinBERT Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Schedule Trigger (Post-Collection)": {
      "main": [
        [
          {
            "node": "Run FinBERT Inference & Feature Alignment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run FinBERT Inference & Feature Alignment": {
      "main": [
        [
          {
            "node": "Check Sentiment Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Sentiment Status": {
      "main": [
        [
          {
            "node": "Log Sentiment Alignment Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log FinBERT Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
