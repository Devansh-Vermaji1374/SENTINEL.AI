{
  "name": "Workflow E - Machine Learning Prediction Generation (SENTINEL.AI)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 12
            }
          ]
        }
      },
      "id": "e44d32a5-0005-4000-8000-000000000001",
      "name": "Schedule Trigger (Pre-Market Close)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://sentinel-backend:8000/api/models/train",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Sentinel-Automation-Key",
              "value": "={{ $env.SENTINEL_AUTOMATION_KEY || 'sentinel-automation-secret-key' }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "e44d32a5-0005-4000-8000-000000000002",
      "name": "Execute Model Validation & Inference",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "value2": "success"
            }
          ]
        }
      },
      "id": "e44d32a5-0005-4000-8000-000000000003",
      "name": "Verify Predictions Generated",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "log_message",
              "value": "Model inference generation verified. Assets processed: {{ $json.predictions_generated || 0 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a5-0005-4000-8000-000000000004",
      "name": "Log Inference Success",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error_alert",
              "value": "Inference generation failed: {{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "e44d32a5-0005-4000-8000-000000000005",
      "name": "Log Inference Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Schedule Trigger (Pre-Market Close)": {
      "main": [
        [
          {
            "node": "Execute Model Validation & Inference",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Model Validation & Inference": {
      "main": [
        [
          {
            "node": "Verify Predictions Generated",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Predictions Generated": {
      "main": [
        [
          {
            "node": "Log Inference Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Inference Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
